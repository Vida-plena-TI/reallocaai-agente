# Ambiente de execução: development | staging | production
APP_ENV=development

# Provedor de IA usado por app/ai (criar_chat_model): "openai" ou "google".
# Os campos OPENAI_* abaixo são exigidos quando AI_PROVIDER=openai; os campos
# GOOGLE_* quando AI_PROVIDER=google. Útil trocar para "google" ao testar
# localmente sem custo, usando uma chave gratuita do Google AI Studio.
AI_PROVIDER=openai

# OpenAI (usado por app/ai via langchain-openai)
OPENAI_API_KEY=sk-your-openai-api-key
# Obrigatório antes de rodar a camada de IA de verdade (criar_chat_model ou o
# script scripts/chat_manual.py) — ainda não decidimos qual modelo usar em
# produção. Não é usado pelos testes automatizados.
OPENAI_MODEL=

# Google Gemini (usado por app/ai via langchain-google-genai)
# Chave gratuita disponível em https://aistudio.google.com — útil para testar
# o agente de ponta a ponta sem custo antes de decidir o modelo de produção.
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=

# Google Sheets (fonte de dados da agenda, usada por app/data_sources)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id

# Resend (envio dos relatórios gerados por app/reports)
RESEND_API_KEY=re_your_resend_api_key
REPORT_EMAIL_FROM=realocai@suaclinica.com.br
# Lista separada por vírgulas
REPORT_EMAIL_TO=coordenacao@suaclinica.com.br,diretoria@suaclinica.com.br

# API HTTP interna (app/api)
# Obrigatório: chave que os endpoints exigem no header X-API-Key.
INTERNAL_API_KEY=
# Lista separada por vírgulas. Vazio em produção até o chat/widget existirem;
# em desenvolvimento, localhost é liberado automaticamente independente desta
# variável.
CORS_ALLOWED_ORIGINS=
# TTL (segundos) do cache de leitura da agenda.
CACHE_TTL_SEGUNDOS=60
