# Copie para .env (uso local) ou cadastre no painel do Easypanel (produção).
# Nenhum valor aqui é real. Veja "Deploy" no README.

# ---- Ambiente ----
# development | staging | production. Em production, CORS_ALLOWED_ORIGINS é obrigatória
# e /docs, /redoc e /openapi.json ficam desligados.
APP_ENV=development
# Opcional. DEBUG | INFO | WARNING | ERROR | CRITICAL (padrão INFO). Logs vão para stdout.
LOG_LEVEL=INFO
# Opcional. true/false força /docs, /redoc e /openapi.json; vazio = ligados só em development.
DOCS_ENABLED=
# Opcional. Porta HTTP do servidor (`python -m app` e o container). Padrão 8000.
PORT=8000

# ---- API HTTP interna ----
# Obrigatória. Chave exigida no header X-API-Key por todas as rotas, menos /health.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# Origens liberadas no CORS, separadas por vírgula ("*" não é aceito).
# Obrigatória em production; em development, localhost:3000 e :5173 já são liberadas.
CORS_ALLOWED_ORIGINS=
# Opcional. TTL (segundos) do cache em memória da leitura da agenda (padrão 60).
CACHE_TTL_SEGUNDOS=60

# ---- Provedor de IA ----
# Obrigatória: "openai" ou "google". Exige as duas variáveis do provedor escolhido.
AI_PROVIDER=openai
# Obrigatórias quando AI_PROVIDER=openai: chave da API e nome do modelo.
OPENAI_API_KEY=
OPENAI_MODEL=
# Obrigatórias quando AI_PROVIDER=google (chave gratuita em https://aistudio.google.com).
GOOGLE_API_KEY=
GOOGLE_MODEL=

# ---- Google Sheets (agenda) ----
# Obrigatória. Id da planilha (trecho da URL entre /d/ e /edit).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Credencial da service account: preencha UMA das duas.
# Produção: conteúdo do JSON, puro ou em base64 (base64 -w0 arquivo.json). Tem prioridade
# sobre o arquivo e nunca é gravada em disco.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Uso local: caminho do arquivo JSON (relativo à raiz do projeto).
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-service-account.json

# ---- Resend (opcional: envio do relatório por e-mail) ----
# Preencha as duas juntas, ou nenhuma. Vazias: envio desligado (POST /relatorio/enviar → 503).
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Opcional. Destinatários padrão, separados por vírgula.
REPORT_EMAIL_TO=
