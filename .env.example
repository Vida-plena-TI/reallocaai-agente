# Ambiente de execução: development | staging | production
APP_ENV=development

# OpenAI (usado por app/ai via langchain-openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Google Sheets (fonte de dados da agenda, usada por app/data_sources)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id

# Resend (envio dos relatórios gerados por app/reports)
RESEND_API_KEY=re_your_resend_api_key
REPORT_EMAIL_FROM=realocai@suaclinica.com.br
# Lista separada por vírgulas
REPORT_EMAIL_TO=coordenacao@suaclinica.com.br,diretoria@suaclinica.com.br
